<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <!-- Версии зафиксированы в квадратных скобках, чтобы docker-сборка не подтянула
         наибольшую версию с фида и не разъехалась с локальной сборкой -->
    <ItemGroup>
      <PackageReference Include="AlfaHackaton.Auth" Version="[1.3.0]" />
      <PackageReference Include="AlfaHackaton.HttpClient" Version="[1.1.1]" />
      <PackageReference Include="AlfaHackaton.Controllers" Version="[1.3.0]" />
      <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    </ItemGroup>

</Project>
